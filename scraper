    // -------------------------------------------------------------------------
    // 4.1 Multi-student Google Sheet batch controller
    // -------------------------------------------------------------------------
    function isBatchBridgeConfigured() {
        let webAppUrlIsValid = false;
        try {
            const parsedUrl = new URL(BATCH_WEB_APP_URL);
            webAppUrlIsValid =
                parsedUrl.protocol === 'https:' &&
                parsedUrl.hostname === 'script.google.com' &&
                /^\/(?:(?:a\/macros\/[^/]+\/)|(?:macros\/))s\/[^/]+\/exec\/?$/i.test(
                    parsedUrl.pathname,
                );
        } catch (error) {
            webAppUrlIsValid = false;
        }

        return (
            webAppUrlIsValid &&
            BATCH_SHARED_SECRET &&
            !/^CHANGE_THIS_/i.test(BATCH_SHARED_SECRET)
        );
    }

    function readBatchState() {
        try {
            return JSON.parse(localStorage.getItem(BATCH_STATE_KEY) || 'null');
        } catch (error) {
            console.error('[BSCS Batch] Invalid saved state:', error);
            localStorage.removeItem(BATCH_STATE_KEY);
            return null;
        }
    }

    function writeBatchState(state) {
        localStorage.setItem(BATCH_STATE_KEY, JSON.stringify(state));
    }

    function setBatchStatus(message, isError = false) {
        const node = document.getElementById('batch-status-msg');
        if (!node) return;
        node.style.color = isError ? '#842029' : '#555';
        node.innerText = message;
    }

    function gmRequestJson({ method = 'GET', url, data = null }) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method,
                url,
                data: data === null ? undefined : JSON.stringify(data),
                headers:
                    data === null
                        ? undefined
                        : {
                              'Content-Type': 'text/plain;charset=UTF-8',
                          },
                timeout: 45000,
                onload: (response) => {
                    let parsed;
                    try {
                        parsed = JSON.parse(response.responseText);
                    } catch (error) {
                        reject(
                            new Error(
                                `Bridge returned non-JSON data (HTTP ${response.status}). Check the deployment URL and access settings.`,
                            ),
                        );
                        return;
                    }

                    if (response.status < 200 || response.status >= 300 || !parsed.ok) {
                        reject(
                            new Error(
                                parsed.error || `Bridge request failed (HTTP ${response.status}).`,
                            ),
                        );
                        return;
                    }
                    resolve(parsed);
                },
                onerror: () => reject(new Error('Could not reach the Google Apps Script bridge.')),
                ontimeout: () => reject(new Error('Google Apps Script bridge timed out.')),
            });
        });
    }

    async function startBatchRun() {
        if (!isBatchBridgeConfigured()) {
            setBatchStatus(
                'Configure BATCH_WEB_APP_URL and BATCH_SHARED_SECRET first. See the setup guide.',
                true,
            );
            return;
        }

        setBatchStatus('Reading current student numbers from the live sheet...');
        try {
            const listUrl = new URL(BATCH_WEB_APP_URL);
            listUrl.searchParams.set('action', 'list');
            listUrl.searchParams.set('secret', BATCH_SHARED_SECRET);
            listUrl.searchParams.set('spreadsheetId', BATCH_SPREADSHEET_ID);
            listUrl.searchParams.set('sheetName', BATCH_SHEET_NAME);
            listUrl.searchParams.set('_', String(Date.now()));

            const response = await gmRequestJson({ url: listUrl.toString() });
            const liveRows = (Array.isArray(response.rows) ? response.rows : [])
                .map((item) => ({
                    row: Number(item?.row),
                    studentNumber: String(item?.studentNumber || '').replace(/\D/g, ''),
                }))
                .filter(
                    (item) =>
                        Number.isInteger(item.row) &&
                        item.row >= BATCH_FIRST_DATA_ROW &&
                        item.studentNumber,
                );

            if (liveRows.length === 0) {
                throw new Error(
                    `No student numbers were found in column A starting at row ${BATCH_FIRST_DATA_ROW}.`,
                );
            }

            // If a stopped/failed run is resumed, retain only the students that
            // were already saved. The remaining queue is rebuilt from the live
            // sheet, so newly added or changed student numbers are included and
            // every destination row is current.
            const existing = readBatchState();
            const completedStudentNumbers = new Set(
                [
                    ...(Array.isArray(existing?.completedStudentNumbers)
                        ? existing.completedStudentNumbers
                        : []),
                    ...(existing?.rows
                        ?.slice(0, Math.max(0, Number(existing.index) || 0))
                        .map((item) => item?.studentNumber) || []),
                ]
                    .map((studentNumber) =>
                        String(studentNumber || '').replace(/\D/g, ''),
                    )
                    .filter(Boolean),
            );
            const rows = liveRows.filter(
                (item) => !completedStudentNumbers.has(item.studentNumber),
            );
            if (rows.length === 0) {
                localStorage.removeItem(BATCH_STATE_KEY);
                setBatchStatus(
                    `All ${liveRows.length} student(s) currently listed in column A have already been saved.`,
                );
                return;
            }

            const state = {
                rows,
                index: 0,
                startedAt: existing?.startedAt || new Date().toISOString(),
                completedStudentNumbers: Array.from(completedStudentNumbers),
            };
            writeBatchState(state);
            setBatchStatus(
                `${completedStudentNumbers.size ? 'Resuming' : 'Starting'} 1/${rows.length}: ${rows[0].studentNumber}`,
            );
            batchResultSubmitted = false;
            initializeAdvisingAssistant(rows[0].studentNumber);
        } catch (error) {
            setBatchStatus(`Batch could not start: ${error.message}`, true);
        }
    }

    function stopBatchRun() {
        localStorage.removeItem(BATCH_STATE_KEY);
        batchResultSubmitted = false;
        setBatchStatus('Batch stopped. Existing sheet results were kept.');
    }

    function uniqueSortedStrings(items) {
        return Array.from(
            new Set(
                items
                    .map((item) => String(item || '').replace(/\s+/g, ' ').trim())
                    .filter(Boolean),
            ),
        ).sort(naturalCourseSort);
    }

    function sheetCellList(items) {
        return uniqueSortedStrings(items).join('\n');
    }

    async function finishBatchStudent(result, errorMessage = '') {
        const state = readBatchState();
        if (
            batchResultSubmitted ||
            !state?.rows?.length ||
            state.index >= state.rows.length
        ) {
            return;
        }

        const target = state.rows[state.index];
        if (
            String(target.studentNumber).replace(/\D/g, '') !==
            currentChecklistStudentNumber
        ) {
            return;
        }

        batchResultSubmitted = true;
        const total = state.rows.length;
        const position = state.index + 1;
        setBatchStatus(`Saving ${position}/${total}: ${target.studentNumber}...`);

        const statusText = errorMessage
            ? `ERROR: ${errorMessage}`
            : `OK - ${new Date().toLocaleString()}`;
        const values = [
            sheetCellList(result?.passedCore || []),
            sheetCellList(result?.canTakeCore || []),
            sheetCellList(result?.creditedGEs || []),
            sheetCellList(result?.canTakeGEs || []),
            sheetCellList(result?.creditedElectives || []),
            sheetCellList(result?.canTakeElective || []),
            sheetCellList(result?.creditedPeNstp || []),
            sheetCellList(result?.canTakePeNstp || []),
            sheetCellList(result?.uncredited || []),
            sheetCellList(result?.enlistments || []),
            statusText,
        ];

        try {
            await gmRequestJson({
                method: 'POST',
                url: BATCH_WEB_APP_URL,
                data: {
                    action: 'update',
                    secret: BATCH_SHARED_SECRET,
                    spreadsheetId: BATCH_SPREADSHEET_ID,
                    sheetName: BATCH_SHEET_NAME,
                    row: target.row,
                    studentNumber: target.studentNumber,
                    values,
                },
            });

            state.completedStudentNumbers = Array.from(
                new Set([
                    ...(Array.isArray(state.completedStudentNumbers)
                        ? state.completedStudentNumbers
                        : []),
                    String(target.studentNumber).replace(/\D/g, ''),
                ]),
            );
            state.index++;
            if (state.index >= total) {
                localStorage.removeItem(BATCH_STATE_KEY);
                setBatchStatus(`Batch complete: ${total} student(s) saved.`);
                return;
            }

            writeBatchState(state);
            const next = state.rows[state.index];
            setBatchStatus(
                `Saved ${position}/${total}. Processing ${state.index + 1}/${total}: ${next.studentNumber}`,
            );
            batchResultSubmitted = false;
            initializeAdvisingAssistant(next.studentNumber);
        } catch (error) {
            batchResultSubmitted = false;
            setBatchStatus(`Save failed for ${target.studentNumber}: ${error.message}`, true);
        }
    }

