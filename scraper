    const GE_LIST_CACHE_TIME_KEY = 'upd_ge_course_list_dynamic_time';
    const GE_LIST_CACHE_SOURCE_KEY = 'upd_ge_course_list_dynamic_source';
    const GE_LIST_CACHE_EXPIRY_MS = 12 * 60 * 60 * 1000;

