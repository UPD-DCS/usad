    // Grade matching regex to cover all UP grade formats (1.0 - 5.0, INC, DRP, etc.)
    const GRADE_REGEX =
        /\b(?:INC(?:\s*\([^)]+\))?|4(?:\.[0-9]+)?(?:\s*\([^)]+\))?|[1-5](?:\.[0-9]+)?|PASSED|FAILED|PASS|FAIL|DRP|S|U)\b/gi;

