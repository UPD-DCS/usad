    function findAdvisingRecordUrl(studentNumber) {
        const normalizedStudentNumber = String(studentNumber || '').replace(/\D/g, '');
        if (!normalizedStudentNumber) return '';

        const rows = Array.from(document.querySelectorAll('tr'));
        const matchingRow = rows.find((row) =>
            (row.innerText || row.textContent || '')
                .replace(/\D/g, '')
                .includes(normalizedStudentNumber),
        );

        if (matchingRow) {
            const rowLink = matchingRow.querySelector(
                'a[href*="/online_advising/advise/"]',
            );
            if (rowLink?.href) return new URL(rowLink.href, location.origin).href;

            const clickable = matchingRow.querySelector(
                '[onclick*="/online_advising/advise/"]',
            );
            const onclickText = clickable?.getAttribute('onclick') || '';
            const onclickUrl = onclickText.match(
                /(?:https:\/\/crs\.upd\.edu\.ph)?(\/online_advising\/advise\/[^'"\s)]+)/i,
            );
            if (onclickUrl) return new URL(onclickUrl[1], location.origin).href;
        }

        const directLinks = Array.from(
            document.querySelectorAll('a[href*="/online_advising/advise/"]'),
        );
        const hrefMatch = directLinks.find((link) =>
            String(link.href || '').replace(/\D/g, '').includes(normalizedStudentNumber),
        );
        if (hrefMatch?.href) return new URL(hrefMatch.href, location.origin).href;

        // Main-page variants do not always render a student-specific anchor.
        // Recover the active term ID from any available advising URL, then use
        // the configured current-term fallback observed in the supplied CRS page.
        const detectedTermId = directLinks
            .map((link) =>
                String(link.href || '').match(
                    /\/online_advising\/advise\/(\d+)\/(?:\d+|[^/?#]+)/i,
                ),
            )
            .find(Boolean)?.[1];
        const termId = detectedTermId || BATCH_ADVISING_TERM_ID;
        return new URL(
            `/online_advising/advise/${encodeURIComponent(termId)}/${encodeURIComponent(normalizedStudentNumber)}`,
            location.origin,
        ).href;
    }

    function parseEnlistmentsFromAdvisingDocument(doc) {
        const enlistedHeading = Array.from(doc.querySelectorAll('h1, h2, h3')).find(
            (heading) =>
                /^enlisted\s+classes$/i.test(
                    (heading.textContent || '').replace(/\s+/g, ' ').trim(),
                ),
        );
        let enlistedTable = null;
        let sibling = enlistedHeading?.nextElementSibling || null;
        while (sibling && !enlistedTable) {
            if (sibling.matches?.('table.classlist')) {
                enlistedTable = sibling;
                break;
            }
            enlistedTable = sibling.querySelector?.('table.classlist') || null;
            sibling = sibling.nextElementSibling;
        }
        enlistedTable = enlistedTable || doc.querySelector('table.classlist');
        if (!enlistedTable) return [];

        const entries = Array.from(enlistedTable.querySelectorAll('tr'))
            .map((row) => {
                const descriptionCell = row.querySelector('td.td_coursedesc');
                if (!descriptionCell) return '';

                const descriptionLines = (descriptionCell.innerText || descriptionCell.textContent || '')
                    .split(/\r?\n/)
                    .map((line) => line.replace(/\s+/g, ' ').trim())
                    .filter(Boolean);
                if (descriptionLines.length === 0) return '';

                // CRS stores the complete class name in the row action's value
                // attribute (for example, "CWTS 1 Engg DCS MQR"). Prefer this
                // authoritative value because visible descriptions may insert
                // line breaks inside multiword NSTP sections.
                const storedClassName =
                    row.querySelector('a[value]')?.getAttribute('value') ||
                    row
                        .querySelector('input[id^="classcodename"]')
                        ?.getAttribute('value') ||
                    '';
                const courseAndSection =
                    storedClassName.replace(/\s+/g, ' ').trim() ||
                    descriptionLines[0];

                // Search the remaining description and row cells for the
                // day/time schedule so minor CRS table-layout changes are handled.
                const otherCellLines = Array.from(row.querySelectorAll(':scope > td'))
                    .filter((cell) => cell !== descriptionCell)
                    .flatMap((cell) =>
                        (cell.innerText || cell.textContent || '')
                            .split(/\r?\n/)
                            .map((line) => line.replace(/\s+/g, ' ').trim())
                            .filter(Boolean),
                    );
                const detailCandidates = [
                    ...descriptionLines.slice(1),
                    ...otherCellLines,
                ];
                const rawSchedule =
                    detailCandidates.find(
                        (line) =>
                            /\b(?:M|T|W|TH|F|S|SUN|MON|TUE|WED|THU|FRI|SAT)+\b.*\d/i.test(
                                line,
                            ) ||
                            /\b\d{1,2}(?::\d{2})?\s*(?:AM|PM)?\s*[-–]\s*\d{1,2}(?::\d{2})?\s*(?:AM|PM)?\b/i.test(
                                line,
                            ),
                    ) ||
                    descriptionLines[1] ||
                    '';
                const dayTimeMatch = rawSchedule.match(
                    /^((?:(?:TH|SU|M|T|W|F|S)\/?)+\s+\d{1,2}(?::\d{2})?\s*(?:AM|PM)?\s*[-–]\s*\d{1,2}(?::\d{2})?\s*(?:AM|PM)?)/i,
                );
                const schedule = dayTimeMatch
                    ? dayTimeMatch[1].replace(/\s+/g, ' ').trim()
                    : rawSchedule
                          .replace(/\s+(?:lec|lab|PE)\b.*$/i, '')
                          .replace(/\s+/g, ' ')
                          .trim();

                if (!schedule || courseAndSection.includes(schedule)) {
                    return courseAndSection;
                }
                return `${courseAndSection} — ${schedule}`;
            })
            .filter(Boolean);

        return uniqueSortedStrings(entries);
    }

    async function loadBatchEnlistments(studentNumber) {
        const recordUrl = findAdvisingRecordUrl(studentNumber);
        if (!recordUrl) {
            currentBatchEnlistments = [
                'Unavailable: advising record link not found on the current page',
            ];
            return currentBatchEnlistments;
        }

        try {
            const response = await fetch(recordUrl, {
                method: 'GET',
                credentials: 'same-origin',
                cache: 'no-store',
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            const html = await response.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const loadedStudentNumber = String(
                doc.querySelector('td.tr_submit h1')?.textContent || '',
            ).replace(/\D/g, '');
            const expectedStudentNumber = String(studentNumber || '').replace(/\D/g, '');
            if (loadedStudentNumber && loadedStudentNumber !== expectedStudentNumber) {
                throw new Error('CRS returned a different student record');
            }

            const parsed = parseEnlistmentsFromAdvisingDocument(doc);
            currentBatchEnlistments = parsed.length > 0 ? parsed : ['None'];
        } catch (error) {
            console.error('[BSCS Batch] Enlistment extraction failed:', error);
            currentBatchEnlistments = [
                `Unavailable: enlistments could not be loaded (${error.message})`,
            ];
        }

        return currentBatchEnlistments;
    }

